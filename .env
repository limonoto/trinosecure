# Database — points at the existing epes-postgres container (port 5432).
# A dedicated `trinosecure` database was created inside it, owned by epes_user.
DATABASE_URL="postgresql://epes_user:change_me_in_production@localhost:5432/trinosecure?schema=public"

# Auth.js + Keycloak — points at the existing epes-keycloak container (port 8080).
# The `trino-secure` realm (client trino-secure-ui, test user admin/admin) was imported
# from keycloak/import/trino-secure-realm.json.
AUTH_SECRET="Crm4mzJxn22BpLGni3DfBLFUnvRjGu3arDiwbFd5rcs="
AUTH_TRUST_HOST=true
# The app runs on port 3110 (3100 is taken by another local project: vardiya-app).
AUTH_URL="http://localhost:3110"
AUTH_KEYCLOAK_ID="trino-secure-ui"
AUTH_KEYCLOAK_SECRET="dev-trino-secure-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/trino-secure"

# Trino cluster (Docker — cluster-trino/)
# Self-signed sertifika olduğu için TLS doğrulamasını devre dışı bırak (sadece dev)
NODE_TLS_REJECT_UNAUTHORIZED=0
# Nizam uygulamasının Trino REST API'ye bağlanmak için kullandığı servis hesabı
TRINO_SERVICE_USER=nizam
TRINO_SERVICE_PASSWORD=nizam-service-2024

# Ansible runner sidecar — headless Ansible executor (Docker Compose: ansible-runner:8000)
ANSIBLE_RUNNER_URL="http://localhost:8082"

# AES-256-GCM key for encrypting SSH credentials at rest (64 hex chars = 32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
