DATABASE_URL="postgresql://trinosecure:trinosecure@localhost:5432/trinosecure?schema=public"

AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL="http://localhost:3110"
AUTH_KEYCLOAK_ID="trino-secure-ui"
AUTH_KEYCLOAK_SECRET="dev-trino-secure-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/trino-secure"

NIZAM_ADMIN_USERS=""

ANSIBLE_RUNNER_URL="http://localhost:8082"

# Allow self-signed TLS certificates on internal Trino coordinators.
# Safe for internal/dev use; remove if all coordinators use trusted CA certs.
NODE_TLS_REJECT_UNAUTHORIZED="0"
