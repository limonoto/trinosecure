# Database — defaults match the bundled docker-compose.yml (trino-secure-db on :5433).
# If you reuse an existing Postgres (e.g. epes-postgres on :5432), point DATABASE_URL there instead.
DATABASE_URL="postgresql://trinosecure:trinosecure@localhost:5433/trinosecure?schema=public"

# Auth.js + Keycloak.
# Defaults below match the bundled docker-compose Keycloak (trino-secure-keycloak on :8081, realm
# imported from keycloak/import/). Test user: admin / admin. If you reuse an existing Keycloak
# (e.g. epes-keycloak on :8080), set AUTH_KEYCLOAK_ISSUER to http://localhost:8080/realms/trino-secure.
# For a real deployment, point these at your own realm/client and set a fresh AUTH_SECRET.
AUTH_SECRET="generate with: openssl rand -base64 32"
AUTH_TRUST_HOST=true
# The app runs on port 3110 (3100 is taken by another local project: vardiya-app).
AUTH_URL="http://localhost:3110"
AUTH_KEYCLOAK_ID="trino-secure-ui"
AUTH_KEYCLOAK_SECRET="dev-trino-secure-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8081/realms/trino-secure"

# Comma-separated usernames/emails that are always PLATFORM_ADMIN (RBAC bootstrap).
NIZAM_ADMIN_USERS=""

# Observability collector (npm run collect → POSTs to /api/collect).
COLLECTOR_URL="http://localhost:3110/api/collect"
COLLECTOR_TOKEN=""
COLLECTOR_CRON="*/30 * * * * *"
