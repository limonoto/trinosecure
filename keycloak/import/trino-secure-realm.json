      "directAccessGrantsEnabled": true,
      "rootUrl": "http://localhost:3100",
      "baseUrl": "http://localhost:3100",
      "redirectUris": ["http://localhost:3100/*"],
      "webOrigins": ["http://localhost:3100"],
      "defaultClientScopes": ["openid", "profile", "email", "roles"]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@trino-secure.local",
      "firstName": "Trino",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "admin", "temporary": false }
      ]
    }
  ]
